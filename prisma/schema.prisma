// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// user model to add new user to the database;
model User {
  id             String      @id @default(uuid())
  name           String
  email          String      @unique
  password       String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  movies         Movie[]     @relation("MovieCreator")
  sessions       Session[]
  watchlistItems Watchlist[]
}

// session schema

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique @map("session_id")
  expiresAt DateTime @map("expires_at")
  userId    String   @map("user_id")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // relation
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Movie {
  id          String    @id @default(uuid())
  title       String
  description String
  overview    String?   @db.Text
  releaseDate DateTime? @map("release_date") @db.Date
  genres      String[]  @default([])
  runtime     Int?      @db.Integer
  posterUrl   String?   @map("poster_url")
  createdBy   String?   @map("created_by")
  ratingCount Int?      @map("rating_count") @db.Integer

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // relations
  creator        User?       @relation("MovieCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  watchlistItems Watchlist[]

  @@index([title])
  @@index([releaseDate])
  @@index([ratingCount])
  @@index([title, releaseDate])
}

model Watchlist {
  id      String            @id @default(uuid())
  userId  String
  movieId String
  status  WatchListStatus[] // Possible values: "to_watch", "watching", "watched"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // relations
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)
}

// Enum for watchlist status
enum WatchListStatus {
  to_watch
  watching
  watched
}
